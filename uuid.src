// Generate a random 4-bit hex digit
//
// Retung string
_rand_hex_digit = function
	n = floor(rnd * 16)
	hex = "0123456789abcdef"
	return hex[n]
end function

// Generate a random n-character hex block
//
// len: int - the length of the hex block
// Return string
_rand_hex_block = function(len)
	s = ""
	for i in range(0, len - 1)
		s = s + _rand_hex_digit()
	end for
	return s
end function

// Generate a full uuid-v4 like string
//
// Return string
uuid = function()
	part1 = _rand_hex_block(8)
	part2 = _rand_hex_block(4)
	part3 = "4" + _rand_hex_block(3)
	part4 = "89ab"[floor(rnd*4)] + _rand_hex_block(3)
	part5 = _rand_hex_block(12)
	return part1 + "-" + part2 + "-" + part3 + "-" + part4 + "-" + part5
end function
