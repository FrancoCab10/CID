// Import CID library (change the path with yours)
import_code("/home/user/cid.src")

clear_screen

lootDb = CID.connect("loot", "lootpass", ["items", "credits"], "/home/user")
configDb = CID.connect("config", "configpass", ["settings"], "/home/user")

print("<color=green>lootDb name/path: " + lootDb.name + " / " + lootDb.path)
print("<color=green>configDb name/path: " + configDb.name + " / " + configDb.path)

print("<color=green>Mutating lootDb.tables must not affect configDb.tables")
lootDb.tables["items"].push({"name": "lockpick"})
print(lootDb.tables)
print(configDb.tables)
