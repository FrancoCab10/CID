// CID (Central Intelligence Database)
// version: 0.1.0
// author: R34lQu1ck'
//
// A GreyScript database library for Grey Hack.
// repository: https://github.com/FrancoCab10/CID
//
// Import with: import_code("/path/to/cid.src")

CID = {}

// Creates a new, independent CID instance. Every call returns its own
// instance, so multiple databases can coexist in the same script.
//
// db_name string, database name, used as the file name
// db_password string, password required to open the compiled binary
// db_tables list, table names to initialize
// db_path string, directory to store the database in. Defaults to /root
// Return CID
CID.connect = function(db_name="CID", db_password="admin", db_tables=["table"], db_path="")
        instance = new CID
        instance.name = db_name
        instance.password = db_password
        instance.db_tables = db_tables
        if db_path == "" then db_path = "/root"
        instance.path = db_path + "/" + instance.name + ".db"
        instance.path = instance.path.replace("//", "/")
        instance.folder = instance.path.split("/")[0:-1].join("/")
        instance.tables = {}
        for table_name in instance.db_tables
                instance.tables[table_name] = []
        end for
        return instance
end function

// Shared builder step: sets the data payload. Used by insert's
// .values() and (later) update's .set().
//
// data map
// Return the builder
_values = function(data)
        self.data = data
        return self
end function

// Runs an insert builder: stores a copy of .data with a fresh uuid
// assigned to its id field, overwriting any id the caller set. Returns
// a separate copy of that row, so modifying it doesn't change the
// stored table without going through update().
//
// Return map (the inserted row) or string (error message) on failure
_insert_execute = function()
        if not self.db.tables.hasIndex(self.table) then return "Table " + self.table + " not found"
        if typeof(self.data) != "map" then return "data must be a map"
        row = {} + self.data
        row.id = uuid()
        self.db.tables[self.table].push(row)
        return {} + row
end function

// Starts an insert builder for a table. Chain .values(data) then
// .execute() to run it.
//
// table string, name of the table to insert into
// Return map, the insert builder
CID.insert = function(table)
        builder = {}
        builder.db = self
        builder.table = table
        builder.data = null
        builder.values = @_values
        builder.execute = @_insert_execute
        return builder
end function

// Leaf condition builders for where(). Each returns a plain map describing
// one field comparison; combine them with CID.and/CID.or.
//
// field string
// value any
// Return map
CID.eq = function(field, value)
        return {"op": "=", "field": field, "value": value}
end function
CID.ne = function(field, value)
        return {"op": "!=", "field": field, "value": value}
end function
CID.gt = function(field, value)
        return {"op": ">", "field": field, "value": value}
end function
CID.gte = function(field, value)
        return {"op": ">=", "field": field, "value": value}
end function
CID.lt = function(field, value)
        return {"op": "<", "field": field, "value": value}
end function
CID.lte = function(field, value)
        return {"op": "<=", "field": field, "value": value}
end function

// Leaf condition builder for a case-insensitive match. pattern may use
// "%" as a wildcard: "%foo", "foo%", "%foo%", or "foo" for an exact match.
//
// field string
// pattern string
// Return map
CID.like = function(field, pattern)
        return {"op": "like", "field": field, "value": pattern}
end function

// Combinators: build a condition tree out of leaf conditions (or other
// and/or nodes) for arbitrary and/or nesting. Take a list since GreyScript
// has no varargs.
//
// clauses list, of conditions built via CID.eq/ne/gt/gte/lt/lte/like/and/or
// Return map
CID.and = function(clauses)
        return {"op": "and", "clauses": clauses}
end function
CID.or = function(clauses)
        return {"op": "or", "clauses": clauses}
end function

// Matches value against a "%"-wildcard pattern, case-insensitive.
//
// value string
// pattern string
// Return boolean
_matches_like = function(value, pattern)
        value = value.lower()
        pattern = pattern.lower()
        starts_wildcard = pattern.len > 0 and pattern[0] == "%"
        ends_wildcard = pattern.len > 0 and pattern[-1] == "%"
        core = pattern
        if starts_wildcard then core = core[1:]
        if ends_wildcard and core.len > 0 then core = core[:-1]
        if starts_wildcard and ends_wildcard then return value.indexOf(core) != null
        if starts_wildcard then return core.len <= value.len and value[value.len - core.len:] == core
        if ends_wildcard then return core.len <= value.len and value[:core.len] == core
        return value == core
end function

// Evaluates a condition tree (built via CID.eq/.../CID.and/or) against a
// row. "and"/"or" nodes recurse over .clauses; leaf nodes compare a field.
//
// row map
// condition map
// Return boolean
_eval_condition = function(row, condition)
        if condition.op == "and" then
                for clause in condition.clauses
                        if not _eval_condition(row, clause) then return false
                end for
                return true
        end if
        if condition.op == "or" then
                for clause in condition.clauses
                        if _eval_condition(row, clause) then return true
                end for
                return false
        end if
        if not row.hasIndex(condition.field) then return false
        v = row[condition.field]
        if condition.op == "=" then return v == condition.value
        if condition.op == "!=" then return v != condition.value
        if condition.op == ">" then return v > condition.value
        if condition.op == ">=" then return v >= condition.value
        if condition.op == "<" then return v < condition.value
        if condition.op == "<=" then return v <= condition.value
        if condition.op == "like" then return _matches_like(str(v), condition.value)
        return false
end function

// Shared builder step: sets the row-filter condition tree, built with
// CID.eq/ne/gt/gte/lt/lte/like and CID.and/or. Used by query's .where()
// and (later) update's/delete's .where().
//
// condition map, built via CID.eq/... and CID.and/or
// Return the builder
_where = function(condition)
        self.condition = condition
        return self
end function

// Runs a query builder: returns a copy of the rows matching .condition
// (fresh list, fresh row maps), so nothing in the result shares state
// with the stored table. No condition set means every row matches.
//
// Return list (the matching rows) or string (error message) on failure
_query_execute = function()
        if not self.db.tables.hasIndex(self.table) then return "Table " + self.table + " not found"
        rows = []
        for row in self.db.tables[self.table]
                if self.condition != null and not _eval_condition(row, self.condition) then continue
                rows.push({} + row)
        end for
        return rows
end function

// Starts a query builder for a table. Chain .where(condition) then
// .execute() to run it. Skipping .where() matches every row.
//
// table string, name of the table to query
// Return map, the query builder
CID.query = function(table)
        builder = {}
        builder.db = self
        builder.table = table
        builder.condition = null
        builder.where = @_where
        builder.execute = @_query_execute
        return builder
end function

// Compiles the in-memory tables into the binary database at self.path,
// replacing any existing file there. The compiled binary only unlocks
// its data when launched with the correct password.
//
// Return 1 (success) or string (error message) on failure
CID.write = function()
        staging_dir = self.folder
        staging_name = md5(rnd() + current_date)[0:6]
        staging_src = staging_name + ".src"
        staging_path = staging_dir + "/" + staging_src
        touch_result = get_shell.host_computer.touch(staging_dir, staging_src)
        if typeof(touch_result) == "string" and touch_result != "" then return "Could not create staging file in " + staging_dir + ": " + touch_result
        staging_file = get_shell.host_computer.File(staging_path)
        if not staging_file then return "Could not create staging file at " + staging_path
        staging_file.chmod("o-rwx")
        staging_file.chmod("g-wx")
        staging_file.chmod("g+r")
        lines = []
        lines.push("if params.len == 0 then exit(""\nThis is a binary database generated by the CID library\nInfo: <color=yellow>https://github.com/FrancoCab10/CID\n"")")
        password_hash = md5(self.password)
        lines.push("if md5(params[0]) != (""" + password_hash + """) then exit(""Permission denied"")")
        lines.push("get_custom_object[""" + self.name + """] = {}")
        for table in self.tables
                lines.push("get_custom_object[""" + self.name + """][""" + table.key + """] = []")
                for row in table.value
                        lines.push("get_custom_object[""" + self.name + """][""" + table.key + """].push(" + @row + ")")
                end for
        end for
        staging_file.set_content(lines.join(char(10)))
        build_result = get_shell.build(staging_path, self.folder, false)
        if typeof(build_result) == "string" and build_result != "" then
                staging_file.delete()
                return "Compilation failed: " + build_result
        end if
        compiled_file = get_shell.host_computer.File(self.folder + "/" + staging_name)
        if not compiled_file then
                staging_file.delete()
                return "Build succeeded but the compiled file is missing"
        end if
        existing_file = get_shell.host_computer.File(self.path)
        if existing_file then existing_file.delete()
        compiled_file.rename(self.name + ".db")
        staging_file.delete()
        return 1
end function
