// CID (Central Intelligence Database)
// version: 0.1.0
// author: R34lQu1ck'
//
// A GreyScript database library for Grey Hack.
// repository: https://github.com/FrancoCab10/CID
//
// Import with: import_code("/path/to/cid.src")

CID = {}

// Prefix for the key this library uses in get_custom_object, which is one
// map shared across every script running in the shell (not namespaced per
// script). Combined with self.path (not just self.name) in write()/read()
// so neither an unrelated script's own use of get_custom_object nor a
// second CID database that happens to share a name at a different path
// can collide with this one.
CID._KEY_PREFIX = "__cid__"

// ==================
// OPERATORS
// ==================

// Leaf condition: field equals value. Combine with CID.every/CID.some.
//
// field string
// value any
// Return map
CID.eq = function(field, value)
        return {"op": "=", "field": field, "value": value}
end function

// Leaf condition: field does not equal value. Combine with CID.every/CID.some.
//
// field string
// value any
// Return map
CID.ne = function(field, value)
        return {"op": "!=", "field": field, "value": value}
end function

// Leaf condition: field is greater than value. Combine with CID.every/CID.some.
//
// field string
// value any
// Return map
CID.gt = function(field, value)
        return {"op": ">", "field": field, "value": value}
end function

// Leaf condition: field is greater than or equal to value. Combine with
// CID.every/CID.some.
//
// field string
// value any
// Return map
CID.gte = function(field, value)
        return {"op": ">=", "field": field, "value": value}
end function

// Leaf condition: field is less than value. Combine with CID.every/CID.some.
//
// field string
// value any
// Return map
CID.lt = function(field, value)
        return {"op": "<", "field": field, "value": value}
end function

// Leaf condition: field is less than or equal to value. Combine with
// CID.every/CID.some.
//
// field string
// value any
// Return map
CID.lte = function(field, value)
        return {"op": "<=", "field": field, "value": value}
end function

// Leaf condition builder for a case-insensitive match. pattern may use
// "%" as a wildcard: "%foo", "foo%", "%foo%", or "foo" for an exact match.
// A literal "%" at either edge is written doubled: "20%%" matches the
// value "20%" exactly, "%%foo" matches a value starting with "%foo".
//
// field string
// pattern string
// Return map
CID.like = function(field, pattern)
        return {"op": "like", "field": field, "value": pattern}
end function

// Combinator: true only if every clause matches (AND). Clauses can be leaf
// conditions or other every/some nodes, nested arbitrarily deep. Takes a
// list since GreyScript has no varargs.
//
// clauses list, of conditions built via CID.eq/ne/gt/gte/lt/lte/like/every/some
// Return map
CID.every = function(clauses)
        return {"op": "and", "clauses": clauses}
end function

// Combinator: true if any clause matches (OR). Clauses can be leaf
// conditions or other every/some nodes, nested arbitrarily deep. Takes a
// list since GreyScript has no varargs.
//
// clauses list, of conditions built via CID.eq/ne/gt/gte/lt/lte/like/every/some
// Return map
CID.some = function(clauses)
        return {"op": "or", "clauses": clauses}
end function

// ==================
// HELPERS
// ==================
// Namespaced under CID (not bare globals) for the same reason as the
// operators above: import_code dumps everything into the caller's global
// scope, and names this short/common are exactly what a consumer's own
// script might already use.

// Shared builder step: sets the data payload. Used by insert's .values()
// and update's .set().
//
// data map
// Return the builder
CID._values = function(data)
        self.data = data
        return self
end function

// Matches value against a "%"-wildcard pattern, case-insensitive.
//
// value string
// pattern string
// Return boolean
CID._matches_like = function(value, pattern)
        value = value.lower()
        core = pattern.lower()
        starts_wildcard = false
        ends_wildcard = false
        if core.len >= 2 and core[0:2] == "%%" then
                core = "%" + core[2:]
        else if core.len > 0 and core[0] == "%" then
                starts_wildcard = true
                core = core[1:]
        end if
        if core.len >= 2 and core[-2:] == "%%" then
                core = core[:-2] + "%"
        else if core.len > 0 and core[-1] == "%" then
                ends_wildcard = true
                core = core[:-1]
        end if
        if starts_wildcard and ends_wildcard then return value.indexOf(core) != null
        if starts_wildcard then return core.len <= value.len and value[value.len - core.len:] == core
        if ends_wildcard then return core.len <= value.len and value[:core.len] == core
        return value == core
end function

// Evaluates a condition tree (built via CID.eq/.../CID.every/CID.some)
// against a row. "and"/"or" nodes recurse over .clauses; leaf nodes
// compare a field.
//
// row map
// condition map
// Return boolean
CID._eval_condition = function(row, condition)
        if condition.op == "and" then
                for clause in condition.clauses
                        if not CID._eval_condition(row, clause) then return false
                end for
                return true
        end if
        if condition.op == "or" then
                for clause in condition.clauses
                        if CID._eval_condition(row, clause) then return true
                end for
                return false
        end if
        if not row.hasIndex(condition.field) then return false
        v = row[condition.field]
        if condition.op == "=" then return v == condition.value
        if condition.op == "!=" then return v != condition.value
        if condition.op == ">" then return v > condition.value
        if condition.op == ">=" then return v >= condition.value
        if condition.op == "<" then return v < condition.value
        if condition.op == "<=" then return v <= condition.value
        if condition.op == "like" then return CID._matches_like(str(v), condition.value)
        return false
end function

// Shared builder step: sets the row-filter condition tree, built with
// CID.eq/ne/gt/gte/lt/lte/like and CID.every/CID.some. Used by query's
// .where() and (later) update's/delete's .where().
//
// condition map, built via CID.eq/... and CID.every/CID.some
// Return the builder
CID._where = function(condition)
        self.condition = condition
        return self
end function

// Shared builder step: sets the sort field/direction for query results,
// applied before offset/limit. direction: "asc" (default) or "desc".
//
// field string
// direction string
// Return the builder
CID._order_by = function(field, direction="asc")
        self.order_field = field
        self.order_direction = direction
        return self
end function

// Shared builder step: sets how many rows query results skip before
// returning any, applied after ordering and before limit.
//
// n number
// Return the builder
CID._offset = function(n)
        self.offset_value = n
        return self
end function

// Shared builder step: sets the max number of rows query results return,
// applied after ordering and offset.
//
// n number
// Return the builder
CID._limit = function(n)
        self.limit_value = n
        return self
end function

// Runs an insert builder: stores a copy of .data with a fresh uuid
// assigned to its id field, overwriting any id the caller set. Returns
// a separate copy of that row, so modifying it doesn't change the
// stored table without going through update().
//
// Return map (the inserted row) or string (error message) on failure
CID._insert_execute = function()
        if not self.db.tables.hasIndex(self.table) then return "Table " + self.table + " not found"
        if typeof(self.data) != "map" then return "data must be a map"
        row = {} + self.data
        row.id = uuid()
        self.db.tables[self.table].push(row)
        return {} + row
end function

// Runs a query builder: returns a copy of the rows matching .condition
// (fresh list, fresh row maps), so nothing in the result shares state
// with the stored table. Pipeline: filter, then order_by, then offset,
// then limit. No condition set means every row matches; skipping
// order_by/offset/limit leaves that step out entirely.
//
// Return list (the matching rows) or string (error message) on failure
CID._query_execute = function()
        if not self.db.tables.hasIndex(self.table) then return "Table " + self.table + " not found"
        rows = []
        for row in self.db.tables[self.table]
                if self.condition != null and not CID._eval_condition(row, self.condition) then continue
                rows.push({} + row)
        end for
        if self.order_field != null then rows.sort(self.order_field, self.order_direction != "desc")
        if self.offset_value != null then rows = rows[self.offset_value:]
        if self.limit_value != null then rows = rows[:self.limit_value]
        return rows
end function

// Runs an update builder: patches every row matching .condition by merging
// .data into it (only the given fields change, everything else on the row
// is untouched), and returns copies of the patched rows. id is never
// patched, even if present in .data -- it's fixed at insert and this engine
// has no foreign-key protection, so a changed id would silently orphan
// anything referencing it. No condition set means every row is patched.
//
// Return list (the patched rows) or string (error message) on failure
CID._update_execute = function()
        if not self.db.tables.hasIndex(self.table) then return "Table " + self.table + " not found"
        if typeof(self.data) != "map" then return "data must be a map"
        updated = []
        for row in self.db.tables[self.table]
                if self.condition != null and not CID._eval_condition(row, self.condition) then continue
                for key in self.data.indexes
                        if key == "id" then continue
                        row[key] = self.data[key]
                end for
                updated.push({} + row)
        end for
        return updated
end function

// Runs a delete builder: removes every row matching .condition from the
// table and returns copies of the removed rows. No condition set means
// every row is removed.
//
// Return list (the deleted rows) or string (error message) on failure
CID._delete_execute = function()
        if not self.db.tables.hasIndex(self.table) then return "Table " + self.table + " not found"
        deleted = []
        kept = []
        for row in self.db.tables[self.table]
                if self.condition != null and not CID._eval_condition(row, self.condition) then
                        kept.push(row)
                else
                        deleted.push({} + row)
                end if
        end for
        self.db.tables[self.table] = kept
        return deleted
end function

// Runs a query builder the same way .execute() does, but returns only the
// first matching row instead of a list -- lets callers skip checking the
// result's length before indexing into it.
//
// Return map (the first matching row), null (no rows matched), or string
// (error message) on failure
CID._query_first = function()
        rows = self.execute()
        if typeof(rows) == "string" then return rows
        if rows.len == 0 then return null
        return rows[0]
end function

// ==================
// QUERY BUILDERS
// ==================

// Creates a new, independent CID instance. Every call returns its own
// instance, so multiple databases can coexist in the same script.
//
// db_name string, database name, used as the file name
// db_password string, password required to open the compiled binary
// db_tables list, table names to initialize
// db_path string, directory to store the database in. Defaults to /root
// Return CID
CID.connect = function(db_name="CID", db_password="admin", db_tables=["table"], db_path="")
        instance = new CID
        instance.name = db_name
        instance.password = db_password
        instance.db_tables = db_tables
        if db_path == "" then db_path = "/root"
        instance.path = db_path + "/" + instance.name + ".db"
        instance.path = instance.path.replace("//", "/")
        instance.folder = instance.path.split("/")[0:-1].join("/")
        instance.tables = {}
        instance.read()
        return instance
end function

// Resets self.tables to empty for each declared table, then loads
// self.path's compiled binary back in if it exists there, overwriting
// with whatever was last written. Called automatically by connect(); call
// again later to pick up changes another script wrote to the same file.
//
// Return CID (self)
CID.read = function()
        for table_name in self.db_tables
                self.tables[table_name] = []
        end for
        existing_file = get_shell.host_computer.File(self.path)
        if not existing_file then return self
        get_shell.launch(self.path, self.password)
        storage_key = CID._KEY_PREFIX + self.path
        if get_custom_object.hasIndex(storage_key) then self.tables = get_custom_object[storage_key]
        return self
end function

// Starts an insert builder for a table. Chain .values(data) then
// .execute() to run it.
//
// table string, name of the table to insert into
// Return map, the insert builder
CID.insert = function(table)
        builder = {}
        builder.db = self
        builder.table = table
        builder.data = null
        builder.values = @CID["_values"]
        builder.execute = @CID["_insert_execute"]
        return builder
end function

// Starts an update builder for a table. Chain .set(data) and .where(condition)
// then .execute() to run it. Patches (merges) .data into every matching row
// instead of replacing it. Skipping .where() patches every row.
//
// table string, name of the table to update
// Return map, the update builder
CID.update = function(table)
        builder = {}
        builder.db = self
        builder.table = table
        builder.data = null
        builder.condition = null
        builder.set = @CID["_values"]
        builder.where = @CID["_where"]
        builder.execute = @CID["_update_execute"]
        return builder
end function

// Starts a delete builder for a table. Chain .where(condition) then
// .execute() to run it. Skipping .where() deletes every row.
//
// table string, name of the table to delete from
// Return map, the delete builder
CID.delete = function(table)
        builder = {}
        builder.db = self
        builder.table = table
        builder.condition = null
        builder.where = @CID["_where"]
        builder.execute = @CID["_delete_execute"]
        return builder
end function

// Starts a query builder for a table. Chain .where(condition),
// .order_by(field, direction), .offset(n), .limit(n) as needed, then
// .execute() to run it. Skipping any of them leaves that step out. Use
// .first() instead of .execute() to get back a single row (or null)
// rather than a list.
//
// table string, name of the table to query
// Return map, the query builder
CID.query = function(table)
        builder = {}
        builder.db = self
        builder.table = table
        builder.condition = null
        builder.order_field = null
        builder.order_direction = "asc"
        builder.offset_value = null
        builder.limit_value = null
        builder.where = @CID["_where"]
        builder.order_by = @CID["_order_by"]
        builder.offset = @CID["_offset"]
        builder.limit = @CID["_limit"]
        builder.execute = @CID["_query_execute"]
        builder.first = @CID["_query_first"]
        return builder
end function

// Compiles the in-memory tables into the binary database at self.path,
// replacing any existing file there. The compiled binary only unlocks
// its data when launched with the correct password.
//
// Return 1 (success) or string (error message) on failure
CID.write = function()
        staging_dir = self.folder
        staging_name = md5(rnd() + current_date)[0:6]
        staging_src = staging_name + ".src"
        staging_path = staging_dir + "/" + staging_src
        touch_result = get_shell.host_computer.touch(staging_dir, staging_src)
        if typeof(touch_result) == "string" and touch_result != "" then return "Could not create staging file in " + staging_dir + ": " + touch_result
        staging_file = get_shell.host_computer.File(staging_path)
        if not staging_file then return "Could not create staging file at " + staging_path
        staging_file.chmod("o-rwx")
        staging_file.chmod("g-wx")
        staging_file.chmod("g+r")
        storage_key = CID._KEY_PREFIX + self.path
        lines = []
        lines.push("if params.len == 0 then exit(""\nThis is a binary database generated by the CID library\nInfo: <color=yellow>https://github.com/FrancoCab10/CID\n"")")
        password_hash = md5(self.password)
        lines.push("if md5(params[0]) != (""" + password_hash + """) then exit(""Permission denied"")")
        lines.push("get_custom_object[""" + storage_key + """] = {}")
        for table in self.tables
                lines.push("get_custom_object[""" + storage_key + """][""" + table.key + """] = []")
                for row in table.value
                        lines.push("get_custom_object[""" + storage_key + """][""" + table.key + """].push(" + @row + ")")
                end for
        end for
        staging_file.set_content(lines.join(char(10)))
        build_result = get_shell.build(staging_path, self.folder, false)
        if typeof(build_result) == "string" and build_result != "" then
                staging_file.delete()
                return "Compilation failed: " + build_result
        end if
        compiled_file = get_shell.host_computer.File(self.folder + "/" + staging_name)
        if not compiled_file then
                staging_file.delete()
                return "Build succeeded but the compiled file is missing"
        end if
        existing_file = get_shell.host_computer.File(self.path)
        if existing_file then existing_file.delete()
        compiled_file.rename(self.name + ".db")
        staging_file.delete()
        return 1
end function
