/*
* CID (Central Intelligence Database)
* version: 0.1.0
* author: R34lQu1ck'
*
* A GreyScript database library for Grey Hack.
* repository: https://github.com/FrancoCab10/CID
*
* Import with: import_code("/path/to/cid.src")
*/

CID = {}

/*
* Creates a new, independent CID instance. Every call returns its own
* instance, so multiple databases can coexist in the same script.
*
* db_name string, database name, used as the file name
* db_password string, password required to open the compiled binary
* db_tables list, table names to initialize
* db_path string, directory to store the database in. Defaults to current_path
* Return CID
*/
CID.connect = function(db_name="CID", db_password="admin", db_tables=["table"], db_path="")
        instance = new CID
        instance.name = db_name
        instance.password = db_password
        instance.db_tables = db_tables
        if db_path == "" then db_path = current_path
        instance.path = db_path + "/" + instance.name + ".db"
        instance.path = instance.path.replace("//", "/")
        instance.folder = instance.path.split("/")[0:-1].join("/")
        instance.tables = {}
        for table_name in instance.db_tables
                instance.tables[table_name] = []
        end for
        return instance
end function

/*
* Starts an insert builder for a table. Chain .values(data) then
* .execute() to run it.
*
* table string, name of the table to insert into
* Return CIDInsert
*/
CID.insert = function(table)
        builder = new CIDInsert
        builder.db = self
        builder.table = table
        builder.data = null
        return builder
end function

/*
* Builder returned by CID.insert(table).
*/
CIDInsert = {}

/*
* Sets the row to insert.
*
* data map, the row to insert
* Return CIDInsert
*/
CIDInsert.values = function(data)
        self.data = data
        return self
end function

/*
* Runs the insert. Stores a shallow copy of data with a fresh uuid
* assigned to its id field, overwriting any id the caller set.
*
* Return map, the inserted row
*/
CIDInsert.execute = function()
        if not self.db.tables.hasIndex(self.table) then return print("Table " + self.table + " not found")
        if typeof(self.data) != "map" then return print("data must be a map")
        row = {} + self.data
        row.id = uuid()
        self.db.tables[self.table].push(row)
        return row
end function
